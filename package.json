{
  "name": "disney-vacation-optimizer",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic optimizer for Walt Disney World vacation configurations, with explicit price provenance.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "vite-node -c vitest.config.ts scripts/bench.ts",
    "db:migrate": "vite-node -c vitest.config.ts scripts/db-migrate.ts",
    "db:import-json": "vite-node -c vitest.config.ts scripts/import-json.ts --",
    "monitor": "vite-node -c vitest.config.ts scripts/monitor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "^16.4.3",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
