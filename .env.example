# Copy to .env (never commit .env).

# Phone alerts via ntfy. Install the ntfy app and subscribe to this topic.
# On the public ntfy.sh server anyone who knows the topic can read it, so make it long and random,
# e.g. the output of: node -e "console.log('ps5-' + crypto.randomUUID())"
NTFY_TOPIC=
# Optional: your own ntfy server, and an access token if the topic is protected.
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Optional: free key from https://developer.bestbuy.com for the official Best Buy Products API.
BESTBUY_API_KEY=
