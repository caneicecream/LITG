# Copy to .env.local and fill in what you need. Nothing here is required:
# without an AI key the planner works fully and the assistant runs in basic mode.

# Optional: where local data (prices, saved trips, conversations) is stored.
# DVO_STORE_PATH=./data/local-store.json

# ── AI assistant (server-side only; never exposed to the browser) ──
# Claude API key. When set, the assistant uses Claude to interpret requests and
# explain results; prices still come only from the optimizer.
# ANTHROPIC_API_KEY=

# "anthropic" (default when a key is set) or "rules" (force basic mode).
# AI_PROVIDER=anthropic

# Model for the assistant (default claude-opus-5-5).
# AI_MODEL=claude-opus-5-5

# Interpretation effort: low | medium | high | xhigh | max (default medium).
# Explanations always use low.
# AI_EFFORT=medium

# Server-side refusal fallbacks are on by default; set to "off" to disable.
# AI_FALLBACKS=on

# ── Database, price history and monitoring (optional) ──
# Without DATABASE_URL the app uses the local JSON file and monitoring is off.
# With it, all data lives in PostgreSQL. Run `npm run db:migrate` first, then
# optionally `npm run db:import-json` to copy your JSON data (the file is only read).
# DATABASE_URL=postgresql://dvo:dvo@localhost:5432/dvo

# Scheduling (pick one; checks can always be run with "Check now"):
#  - in-app: checks due monitors every 15 minutes while the server runs
# MONITOR_SCHEDULER=on
#  - external: cron calls POST /api/monitoring/run with header x-monitor-secret
# MONITOR_CRON_SECRET=
#  - or cron runs `npm run monitor`

# Optional email notifications (in-app notifications always work).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# NOTIFY_EMAIL_FROM=Disney Vacation Optimizer <alerts@example.com>

# Tests: PostgreSQL suites run only when this is set (each file uses its own schema).
# TEST_DATABASE_URL=postgresql://dvo:dvo@localhost:5432/dvo_test
