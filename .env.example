# Copy to .env.local and fill in what you need. Nothing here is required:
# without an AI key the planner works fully and the assistant runs in basic mode.

# Optional: where local data (prices, saved trips, conversations) is stored.
# DVO_STORE_PATH=./data/local-store.json

# ── AI assistant (server-side only; never exposed to the browser) ──
# Claude API key. When set, the assistant uses Claude to interpret requests and
# explain results; prices still come only from the optimizer.
# ANTHROPIC_API_KEY=

# "anthropic" (default when a key is set) or "rules" (force basic mode).
# AI_PROVIDER=anthropic

# Model for the assistant (default claude-opus-5-5).
# AI_MODEL=claude-opus-5-5

# Interpretation effort: low | medium | high | xhigh | max (default medium).
# Explanations always use low.
# AI_EFFORT=medium

# Server-side refusal fallbacks are on by default; set to "off" to disable.
# AI_FALLBACKS=on
